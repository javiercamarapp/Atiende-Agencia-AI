// ESQUELETO INACTIVO (ver docs/E2E-PLAYWRIGHT.md). Humo de navegador: sin sesion, sin datos, sin escribir nada.
import { expect, test } from "@playwright/test";

test("la SPA carga sin errores de consola", async ({ page }) => {
  const errores: string[] = [];
  page.on("console", (m) => {
    if (m.type() === "error") errores.push(m.text());
  });
  await page.goto("/");
  await expect(page).toHaveTitle(/.+/);
  expect(errores).toEqual([]);
});

test("una ruta protegida sin sesion lleva a login", async ({ page }) => {
  await page.goto("/app");
  await expect(page).toHaveURL(/login/);
});

test("login con credenciales inexistentes muestra un error y no entra", async ({ page }) => {
  await page.goto("/login");
  await page.getByLabel(/correo|email/i).fill("e2e-humo@no-existe.invalid");
  await page.getByLabel(/contrase/i).fill("contrasena-que-no-existe");
  await page.getByRole("button", { name: /entrar|iniciar/i }).click();
  await expect(page.getByRole("alert")).toBeVisible();
  await expect(page).toHaveURL(/login/);
});
