// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderTicketCocinaHtml > snapshot del ticket completo a domicilio 1`] = `"<article class="tk" data-folio="6789AB"><h1>COCINA · Centro</h1><div class="centro">Folio <strong>#6789AB</strong></div><div class="canal">DOMICILIO</div><div class="fila"><span>Recibido</span><span>19/09/26, 10:05</span></div><div class="fila"><span>Hora prometida</span><span><strong>10:45</strong></span></div><hr class="sep"><div class="etq">CLIENTE</div><div>Juan Pérez</div><div>Tel: 5511112222</div><div class="nota">Dir: Calle Falsa 123, entre Reforma y Juárez. Portón negro</div><hr class="sep"><div class="etq">PEDIDO</div><div class="linea"><span class="cant">3x</span><span>Tacos al pastor</span></div><div class="mod">+ Tortilla: maíz</div><hr class="sep"><div class="etq">SALSAS / COMPLEMENTOS</div><div class="nota">Incluir: salsa verde, salsa roja, limones</div><div class="nota">Extra: salsa habanero</div><hr class="sep"><div class="etq">NOTAS</div><div class="nota">Sin cebolla en el pastor</div><hr class="sep"><div class="fila"><span>Pago</span><span>Tarjeta</span></div><div class="canal">LLEVAR TERMINAL</div><div class="fila"><span>Propina (tarjeta)</span><span>$30.00</span></div><div class="fila"><span class="etq">Total</span><span class="etq">$345.50</span></div></article>"`;
