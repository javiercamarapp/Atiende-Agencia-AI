# Variables del worker de voz (solo NOMBRES; los valores viven en los secretos de Fly). Detalle de cada una: README.md, "Variables de entorno".
# Obligatorias
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ATIENDE_API_URL=
INTERNAL_SECRET=
VOICE_DNIS_MAP=
# Una por sucursal: el nombre lo fija `secretoEnv` en VOICE_DNIS_MAP
VOICE_SECRET_FCO=

# Cerebro (OpenRouter, ZDR) y Gemini Live (opcional)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
VOZ_LLM_PROVEEDORES_ZDR=

# Stack de PM: cascada v2 con ElevenLabs (Deepgram de respaldo), Krisp y escalera sin voz a voz
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
VOZ_CASCADA_V2_HABILITADA=1
VOZ_ESCALERA=cascada-v2,cascada-openrouter
VOZ_RUIDO=krisp-telefonia

# Opcionales
VOICE_COSTO_MAX_LLAMADA_USD=
VOICE_TOPE_MENSUAL_USD=
VOICE_ROOM_PREFIX=
VOICE_ASSETS_DIR=
PORT=
