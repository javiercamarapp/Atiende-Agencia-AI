{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build --workspace apps/web && node scripts/build-vercel-function.mjs",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/v1/:path*", "destination": "/api" },
    { "source": "/internal/:path*", "destination": "/api" },
    {
      "source": "/hoteles/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/index.html"
    },
    {
      "source": "/despachos/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/index.html"
    },
    {
      "source": "/licitaciones/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/index.html"
    },
    {
      "source": "/rentas/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/index.html"
    },
    {
      "source": "/superadmin/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/index.html"
    },
    { "source": "/hoteles/:path*", "destination": "/api" },
    { "source": "/despachos/:path*", "destination": "/api" },
    { "source": "/licitaciones/:path*", "destination": "/api" },
    { "source": "/rentas/:path*", "destination": "/api" },
    { "source": "/superadmin/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/internal/licitaciones/discover-tenders", "schedule": "0 5 * * *" },
    { "path": "/internal/licitaciones/deadline-reminders", "schedule": "0 6 * * *" },
    { "path": "/internal/licitaciones/alert-notifications", "schedule": "0 7 * * *" },
    { "path": "/internal/licitaciones/email-dispatch", "schedule": "0 8 * * *" },
    { "path": "/internal/hoteles/night-audit", "schedule": "0 9 * * *" },
    { "path": "/internal/citas/confirmacion-cita", "schedule": "0 14 * * *" },
    { "path": "/internal/citas/email-dispatch", "schedule": "5 14 * * *" },
    { "path": "/internal/citas/google-calendar-sync", "schedule": "10 14 * * *" },
    { "path": "/internal/hoteles/email-dispatch", "schedule": "15 14 * * *" },
    { "path": "/internal/restaurantes/email-dispatch", "schedule": "20 14 * * *" },
    { "path": "/internal/despachos/cobranza-reminders", "schedule": "25 14 * * *" },
    { "path": "/internal/despachos/email-dispatch", "schedule": "30 14 * * *" },
    { "path": "/internal/rentas/email-dispatch", "schedule": "35 14 * * *" },
    { "path": "/internal/rentas/checkin-recordatorio", "schedule": "40 14 * * *" },
    { "path": "/internal/rentas/ical-sync", "schedule": "45 14 * * *" },
    { "path": "/internal/rentas/checkout-sweep", "schedule": "50 14 * * *" },
    { "path": "/internal/whatsapp/dispatch", "schedule": "55 14 * * *" },
    { "path": "/internal/superadmin/resumen-diario", "schedule": "0 15 * * *" },
    { "path": "/internal/superadmin/mantenimiento", "schedule": "5 15 * * *" },
    { "path": "/internal/hoteles/revenue-recommendations", "schedule": "10 15 * * *" }
  ]
}
