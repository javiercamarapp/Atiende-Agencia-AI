node_modules/
dist/
.env
.env.*
!.env.example
*.log
.DS_Store
.pgdata/
coverage/
.vercel/

# api/index.js.map SÍ se ignora (sourcemap del bundle, ~1-2 MB, sin valor fuera de
# depurar un deploy puntual). api/index.js NO se ignora -- ver el comentario en ese
# mismo archivo del repo: Vercel exige que exista en el árbol de git para validar
# `vercel.json::functions` ANTES de correr el buildCommand (hallazgo real, ver
# scripts/build-vercel-function.mjs); el placeholder versionado aquí se sobreescribe
# siempre con el bundle real en cada build.
/api/index.js.map
.vercel
.env*

# Respaldos y reportes del drill (contienen datos personales de todos los tenants)
respaldos/
drill-report-*/

# E2E de navegador (Playwright): builds y reportes locales
apps/web/dist-e2e/
apps/web/playwright-report/
apps/web/test-results/
apps/web/blob-report/
scripts/eval-copiloto/salida/

# Audios pregrabados de la llamada (se generan una vez con `npm run voz:pregrabados` y viajan en la imagen del worker; no se versionan)
apps/voice-worker/assets/*.wav
apps/web/bundle-manifest.json
