-- Fixtures + assertions contra Postgres REAL (RLS + GRANT + definer + auth.uid() reales) para
-- packages/domain-licitaciones/migrations/034_licitaciones_retamizado_kyc_y_avisos.sql
-- (L-32: re-tamizado de la cartera KYC 69-B por edicion de la lista; L-30: conteo de sistema de
-- documentos de empresa por vencer).
--
-- Actores (todos "authenticated"): c1 = owner Org A, c4 = viewer Org A, c2 = owner Org B (otro tenant).
-- Sesion de sistema = rol authenticated con sub vacio (auth.uid() null), como la sesion de la app.
-- Org D3 es de la vertical DESPACHOS: tiene una ficha insertada por el superusuario y NO debe evaluarse.
--
-- Cartera de A: PRE850101AB1 (proveedor), DEF900202CD2 (proveedor), OKK750505IJ5 (proveedor),
--               COM700101AB1 (competidor). Cartera de B: PRE850101AB1 (proveedor).
-- Las ediciones de la lista se insertan DENTRO de cada escenario (como superusuario, antes de cambiar
-- de rol): cada escenario es su propio begin/rollback y arranca sin ninguna edicion cargada.
--
-- Convenciones del gate (scripts/verify-real-postgres-ci/run-gate.mjs): `as should_fail` = el escenario
-- DEBE terminar en ERROR; cualquier otro escenario debe completar sin error (los positivos y los
-- negativos con SQLSTATE exacto afirman con DO ... raise exception).
\set ON_ERROR_STOP off
\pset pager off

insert into core.organization (id, vertical, name, slug) values
  ('00000000-0000-0000-0000-0000000000e1', 'licitaciones', 'Org A (retamizado)', 'org-a-retam'),
  ('00000000-0000-0000-0000-0000000000e2', 'licitaciones', 'Org B (retamizado, ajena)', 'org-b-retam'),
  ('00000000-0000-0000-0000-0000000000e3', 'despachos', 'Despacho (retamizado, otra vertical)', 'despacho-retam')
on conflict do nothing;

insert into core.staff_user (id, email, full_name, created_via) values
  ('00000000-0000-0000-0000-0000000000f1', 'owner-a-retam@example.com', 'Owner A', 'seed'),
  ('00000000-0000-0000-0000-0000000000f2', 'owner-b-retam@example.com', 'Owner B (ajeno)', 'seed'),
  ('00000000-0000-0000-0000-0000000000f4', 'viewer-a-retam@example.com', 'Viewer A', 'seed')
on conflict do nothing;

insert into core.membership (user_id, organization_id, property_ids, platform_role, vertical_role) values
  ('00000000-0000-0000-0000-0000000000f1', '00000000-0000-0000-0000-0000000000e1', null, 'owner', 'owner'),
  ('00000000-0000-0000-0000-0000000000f4', '00000000-0000-0000-0000-0000000000e1', null, 'viewer', 'viewer'),
  ('00000000-0000-0000-0000-0000000000f2', '00000000-0000-0000-0000-0000000000e2', null, 'owner', 'owner')
on conflict do nothing;

insert into licitaciones.kyc_party (organization_id, rfc, rol, nombre) values
  ('00000000-0000-0000-0000-0000000000e1', 'PRE850101AB1', 'proveedor', 'Proveedor presunto'),
  ('00000000-0000-0000-0000-0000000000e1', 'DEF900202CD2', 'proveedor', 'Proveedor definitivo'),
  ('00000000-0000-0000-0000-0000000000e1', 'OKK750505IJ5', 'proveedor', 'Proveedor limpio'),
  ('00000000-0000-0000-0000-0000000000e1', 'COM700101AB1', 'competidor', 'Competidor presunto'),
  ('00000000-0000-0000-0000-0000000000e2', 'PRE850101AB1', 'proveedor', 'Mismo RFC en otro tenant'),
  ('00000000-0000-0000-0000-0000000000e3', 'PRE850101AB1', 'proveedor', 'Ficha de una org de despachos');

\echo ''
\echo '=== licitaciones: re-tamizado KYC 69-B y documentos por vencer (034) ==='
\echo ''

\echo '--- 1. POSITIVO: sin ninguna edicion cargada la funcion no devuelve nada ni falla ---'
begin;
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
do $$ declare n integer; begin
  select count(*) into n from licitaciones.system_retamizar_cartera_kyc();
  if n <> 0 then raise exception 'sin lista debia devolver 0 filas, obtuve %', n; end if;
end $$;
rollback;

\echo '--- 2. POSITIVO: la primera edicion es LINEA BASE (guarda y no marca empeoramiento), solo orgs de licitaciones ---'
begin;
insert into despachos.efos_ingesta (periodo, fuente_sha256, filas) values ('2024-05', repeat('a', 64), 1);
insert into despachos.efos_contribuyente (periodo, rfc, nombre, situacion, fecha_presuncion_sat) values
  ('2024-05', 'PRE850101AB1', 'PRESUNTA FICTICIA SA', 'presunto', '2024-05-12');
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
create temp table corrida1 as select * from licitaciones.system_retamizar_cartera_kyc();
do $$ declare a record; b record; n integer; begin
  select * into a from corrida1 where out_organization_id = '00000000-0000-0000-0000-0000000000e1';
  select * into b from corrida1 where out_organization_id = '00000000-0000-0000-0000-0000000000e2';
  select count(*) into n from corrida1;
  if a.out_evaluadas <> 4 or a.out_empeoradas <> 0 or a.out_proveedores_empeorados <> 0 or a.out_periodo <> '2024-05' then raise exception 'org A linea base mal: %', a; end if;
  if b.out_evaluadas <> 1 or b.out_empeoradas <> 0 then raise exception 'org B linea base mal: %', b; end if;
  if n <> 2 then raise exception 'solo las 2 orgs de licitaciones debian evaluarse (la de despachos no), obtuve % filas', n; end if;
end $$;
rollback;

\echo '--- 3. POSITIVO: una edicion nueva que EMPEORA alerta; repetir la corrida no vuelve a devolver nada ---'
begin;
insert into despachos.efos_ingesta (periodo, fuente_sha256, filas) values ('2024-05', repeat('a', 64), 0);
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
create temp table base as select * from licitaciones.system_retamizar_cartera_kyc();
reset role;
insert into despachos.efos_ingesta (periodo, fuente_sha256, filas) values ('2024-06', repeat('b', 64), 3);
insert into despachos.efos_contribuyente (periodo, rfc, nombre, situacion, fecha_presuncion_sat, fecha_definitivo_sat) values
  ('2024-06', 'PRE850101AB1', 'PRESUNTA FICTICIA SA', 'presunto', '2024-05-12', null),
  ('2024-06', 'DEF900202CD2', 'DEFINITIVA FICTICIA SA', 'definitivo', '2024-01-15', '2024-06-03'),
  ('2024-06', 'COM700101AB1', 'COMPETIDOR FICTICIO SA', 'presunto', '2024-06-01', null);
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
create temp table corrida2 as select * from licitaciones.system_retamizar_cartera_kyc();
create temp table corrida3 as select * from licitaciones.system_retamizar_cartera_kyc();
do $$ declare a record; b record; n integer; begin
  select * into a from corrida2 where out_organization_id = '00000000-0000-0000-0000-0000000000e1';
  select * into b from corrida2 where out_organization_id = '00000000-0000-0000-0000-0000000000e2';
  if a.out_periodo <> '2024-06' or a.out_evaluadas <> 4 or a.out_empeoradas <> 3 or a.out_proveedores_empeorados <> 2 then raise exception 'org A empeoramiento mal: %', a; end if;
  if b.out_evaluadas <> 1 or b.out_empeoradas <> 1 or b.out_proveedores_empeorados <> 1 then raise exception 'org B empeoramiento mal: %', b; end if;
  select count(*) into n from corrida3;
  if n <> 0 then raise exception 'repetir la corrida con la misma edicion y SHA debia devolver 0 filas, obtuve %', n; end if;
end $$;
rollback;

\echo '--- 4. POSITIVO: si nada cambio (misma situacion) o mejoro, no hay empeoramiento ---'
begin;
insert into despachos.efos_ingesta (periodo, fuente_sha256, filas) values ('2024-06', repeat('b', 64), 3);
insert into despachos.efos_contribuyente (periodo, rfc, nombre, situacion, fecha_presuncion_sat, fecha_definitivo_sat) values
  ('2024-06', 'PRE850101AB1', 'PRESUNTA FICTICIA SA', 'presunto', '2024-05-12', null),
  ('2024-06', 'DEF900202CD2', 'DEFINITIVA FICTICIA SA', 'definitivo', '2024-01-15', '2024-06-03');
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
create temp table linea as select * from licitaciones.system_retamizar_cartera_kyc();
reset role;
insert into despachos.efos_ingesta (periodo, fuente_sha256, filas) values ('2024-07', repeat('c', 64), 2);
insert into despachos.efos_contribuyente (periodo, rfc, nombre, situacion, fecha_presuncion_sat, fecha_desvirtuado_sat) values
  ('2024-07', 'PRE850101AB1', 'PRESUNTA FICTICIA SA', 'presunto', '2024-05-12', null),
  ('2024-07', 'DEF900202CD2', 'DEFINITIVA FICTICIA SA', 'desvirtuado', '2024-01-15', '2024-07-02');
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
create temp table nueva as select * from licitaciones.system_retamizar_cartera_kyc();
do $$ declare a record; begin
  select * into a from nueva where out_organization_id = '00000000-0000-0000-0000-0000000000e1';
  if a.out_periodo <> '2024-07' or a.out_evaluadas <> 4 or a.out_empeoradas <> 0 or a.out_proveedores_empeorados <> 0 then
    raise exception 'sin cambios o con mejora no debia marcar empeoramiento: %', a; end if;
end $$;
rollback;

\echo '--- 5. POSITIVO: si el SAT corrige la edicion (SHA distinto) se reevalua y un empeoramiento nuevo si alerta ---'
begin;
insert into despachos.efos_ingesta (periodo, fuente_sha256, filas) values ('2024-05', repeat('a', 64), 0);
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
create temp table c0 as select * from licitaciones.system_retamizar_cartera_kyc();
reset role;
insert into despachos.efos_ingesta (periodo, fuente_sha256, filas) values ('2024-06', repeat('b', 64), 0);
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
create temp table c1 as select * from licitaciones.system_retamizar_cartera_kyc();
reset role;
update despachos.efos_ingesta set fuente_sha256 = repeat('d', 64), filas = 1 where periodo = '2024-06';
insert into despachos.efos_contribuyente (periodo, rfc, nombre, situacion, fecha_definitivo_sat) values
  ('2024-06', 'OKK750505IJ5', 'CORREGIDA FICTICIA SA', 'definitivo', '2024-06-09');
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
create temp table c2 as select * from licitaciones.system_retamizar_cartera_kyc();
do $$ declare a record; x record; begin
  select * into x from c1 where out_organization_id = '00000000-0000-0000-0000-0000000000e1';
  if x.out_empeoradas <> 0 then raise exception 'la edicion vacia no debia empeorar nada: %', x; end if;
  select * into a from c2 where out_organization_id = '00000000-0000-0000-0000-0000000000e1';
  if a.out_empeoradas <> 1 or a.out_proveedores_empeorados <> 1 then raise exception 'la correccion debia alertar 1 proveedor: %', a; end if;
end $$;
rollback;

\echo '--- 6. RLS / CROSS-TENANT: cada organizacion lee solo su historial; el viewer de A tambien lee el de A ---'
begin;
insert into despachos.efos_ingesta (periodo, fuente_sha256, filas) values ('2024-06', repeat('b', 64), 0);
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
select count(*) from licitaciones.system_retamizar_cartera_kyc();
select set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000f1', true);
do $$ declare n integer; m integer; begin
  select count(*) into n from licitaciones.kyc_retamizado;
  select count(*) into m from licitaciones.kyc_retamizado where organization_id <> '00000000-0000-0000-0000-0000000000e1';
  if n <> 4 or m <> 0 then raise exception 'owner A debia ver exactamente las 4 filas de A, vio % (% ajenas)', n, m; end if;
end $$;
select set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000f4', true);
do $$ declare n integer; begin
  select count(*) into n from licitaciones.kyc_retamizado;
  if n <> 4 then raise exception 'viewer A debia ver las 4 filas de A, vio %', n; end if;
end $$;
select set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000f2', true);
do $$ declare n integer; m integer; begin
  select count(*) into n from licitaciones.kyc_retamizado;
  select count(*) into m from licitaciones.kyc_retamizado where organization_id = '00000000-0000-0000-0000-0000000000e1';
  if n <> 1 or m <> 0 then raise exception 'owner B debia ver solo su fila, vio % (% de A)', n, m; end if;
end $$;
rollback;

\echo '--- 7. NEGATIVO: un usuario real (sub) no puede ejecutar las funciones de sistema ---'
begin;
set local role authenticated;
select set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000f1', true);
do $$ begin
  perform licitaciones.system_retamizar_cartera_kyc();
  raise exception 'el staff no debia poder re-tamizar';
exception when sqlstate '42501' then null;
end $$;
do $$ begin
  perform licitaciones.system_count_company_documents_expiring('00000000-0000-0000-0000-0000000000e1', current_date, 30);
  raise exception 'el staff no debia poder contar documentos con la funcion de sistema';
exception when sqlstate '42501' then null;
end $$;
rollback;

\echo '--- 8. ANON: ni las funciones ni la tabla ---'
begin;
set local role anon;
-- as should_fail (permission denied for function)
select * from licitaciones.system_retamizar_cartera_kyc() as should_fail;
rollback;

begin;
set local role anon;
-- as should_fail (permission denied for function)
select licitaciones.system_count_company_documents_expiring('00000000-0000-0000-0000-0000000000e1', current_date, 30) as should_fail;
rollback;

begin;
set local role anon;
-- as should_fail (permission denied for table)
select count(*) as should_fail from licitaciones.kyc_retamizado;
rollback;

\echo '--- 9. NEGATIVO: el cliente no puede escribir ni borrar el historial (solo la funcion de sistema) ---'
begin;
set local role authenticated;
select set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000f1', true);
-- as should_fail (permission denied for table kyc_retamizado)
insert into licitaciones.kyc_retamizado (organization_id, rfc, rol, periodo, semaforo, fuente_sha256)
  values ('00000000-0000-0000-0000-0000000000e1', 'PRE850101AB1', 'proveedor', '2024-06', 'verde', repeat('z', 64)) returning 1 as should_fail;
rollback;

begin;
set local role authenticated;
select set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000f1', true);
-- as should_fail (permission denied for table kyc_retamizado)
delete from licitaciones.kyc_retamizado returning 1 as should_fail;
rollback;

\echo '--- 10. POSITIVO: conteo de sistema de documentos por vencer (solo aprobados, dentro de la ventana, por organizacion) ---'
begin;
insert into licitaciones.company_document (organization_id, document_type, label, expires_at, approval_status) values
  ('00000000-0000-0000-0000-0000000000e1', 'opinion_32d', 'Opinion 32-D', current_date + 10, 'aprobado'),
  ('00000000-0000-0000-0000-0000000000e1', 'acta', 'Acta lejana', current_date + 60, 'aprobado'),
  ('00000000-0000-0000-0000-0000000000e1', 'poder', 'Pendiente de aprobar', current_date + 5, 'pendiente_aprobacion'),
  ('00000000-0000-0000-0000-0000000000e1', 'constancia', 'Ya vencida', current_date - 1, 'aprobado'),
  ('00000000-0000-0000-0000-0000000000e1', 'indefinido', 'Sin vigencia', null, 'aprobado'),
  ('00000000-0000-0000-0000-0000000000e2', 'opinion_32d', 'Opinion 32-D de B', current_date + 3, 'aprobado');
set local role authenticated;
select set_config('request.jwt.claim.sub', '', true);
do $$ declare a integer; b integer; begin
  a := licitaciones.system_count_company_documents_expiring('00000000-0000-0000-0000-0000000000e1', current_date, 30);
  b := licitaciones.system_count_company_documents_expiring('00000000-0000-0000-0000-0000000000e2', current_date, 30);
  if a <> 1 or b <> 1 then raise exception 'esperaba 1 y 1, obtuve % y %', a, b; end if;
  if licitaciones.system_count_company_documents_expiring('00000000-0000-0000-0000-0000000000e1', current_date, 90) <> 2 then raise exception 'con 90 dias A debia contar 2'; end if;
end $$;
do $$ begin
  perform licitaciones.system_count_company_documents_expiring('00000000-0000-0000-0000-0000000000e1', current_date, 0);
  raise exception 'p_days = 0 debia rechazarse';
exception when sqlstate '22023' then null;
end $$;
rollback;
